#!/bin/bash

set -o pipefail

# check the environment (Linux, Mac) to find base path where DRC is installed
case "$(uname -s)" in

   Darwin)
     CONFIG_DIR="/usr/local/share/drc/config"
     ;;

   Linux)
     CONFIG_DIR=/usr/share/drc/config
     ;;

   *)
     exit 1
     ;;
esac

WAVE_EXT=wav
RAW_EXT=pcm
DRC_EXT=drc
DEFAULT_NAME_MIC_COMPENSATION_FILE=mic_compensation_file
DEFAULT_NAME_TARGET_CURVE_FILE=target_curve_file
DRC_CONFIGURATION_FREQUENCY_FOLDER="44.1 kHz"
DRC_CONFIGURATION_FILE_PREFIX=erb
DRC_CONFIGURATION_FILE_FREQUENCY=44.1
IMPULSE_RESPONSE_RAW_FILE_SUFFIX=impulse_response_raw
MIC_COMPENSATED_IMPULSE_RESPONSE_SUFFIX=mic_compensated_impulse_response
MINIMUM_PHASE_SUFFIX=minimum_phase
TEST_CONVOLUTION_SUFFIX=test_convolution

IMPULSE_RESPONSE_BIT_DEPTH=32
OPERATING_FREQUENCY=44100
A_FACTOR_EP_LOWER_WINDOW=24
START_FREQ=20
END_FREQ=20000
PEAK_LIMITING_MAX_GAIN=2
WINDOW_EXPONENT=1

function print_help {
 echo >&2
 echo "drc is intended to be used with 44100 Hz files but other frequency configuration files are provided but they aren't tested" >&2
 echo >&2
 echo "when exporting impulse response please be sure it is a signed integer 32 bit wav to achieve the best result" >&2
 echo >&2
 echo "USAGE drcwrapper [OPTIONS] IMPULSE [IMPULSE ...]" >&2
 echo >&2
 echo "-b, --bit-depth		impulse response bit depth. Default is 32" >&2
 echo "-f, --frequency		operating frequency. It can be 44100, 48000, 88200 or 96000. Default is 44100" >&2
 echo "-c, --config		DRC configuration preset (minimal, soft, normal, strong, extreme, insane, erb)" >&2
 echo "-m, --mic-compensation	mic compensation file" >&2
 echo "-t, --target-curve	target curve" >&2
 echo "-s, --start-frequency	lower end frequency that your speaker can reproduce" >&2
 echo "-e, --end-frequency	higher end frequency that your speaker can reproduce" >&2
 echo "-g, --max-gain		Maximum gain allowed in the correction filter. Peaks in the correction filter amplitude response greater than this value will be compressed to PLMaxGain. Typical values are between 1.2 and 4. A typical value is 2.0, i.e. 6 dB." >&2
 echo "-p, --window-exponent	window exponent. Increasing it gives higher correction in the midrange. Typical values are between 0.7 and 1.2" >&2
 echo "-l, --lower-window	lower correction window in milliseconds" >&2
 echo "-u, --upper-window	upper correction window in milliseconds" >&2
 echo "-o, --output-dir		add drcwrapper working directory" >&2
 echo "-h, --help		show this help" >&2
 echo >&2
}

# $1 is the filename to create
# $2 is sampling rate
# first row in the file must be 0
# last row in the file must be sampling rate / 2
function print_flat_file {
  printf "0 -30\n%d -30\n" "$(( $2 / 2 ))" > "$1"
}


function set_operating_frequency {
  case $1 in
   "44100")
       DRC_CONFIGURATION_FREQUENCY_FOLDER="44.1 kHz"
       DRC_CONFIGURATION_FILE_FREQUENCY=44.1
       OPERATING_FREQUENCY=44100
       ;;
   "48000")
       DRC_CONFIGURATION_FREQUENCY_FOLDER="48.0 kHz"
       DRC_CONFIGURATION_FILE_FREQUENCY=48.0
       OPERATING_FREQUENCY=48000
       ;;
   "88200")
       DRC_CONFIGURATION_FREQUENCY_FOLDER="88.2 kHz"
       DRC_CONFIGURATION_FILE_FREQUENCY=88.2
       OPERATING_FREQUENCY=88200
       ;;
   "96000")
       DRC_CONFIGURATION_FREQUENCY_FOLDER="96.0 kHz"
       DRC_CONFIGURATION_FILE_FREQUENCY=96.0
       OPERATING_FREQUENCY=96000
       ;;
  esac
}


# return current timestamp
function timestamp() {
  date +"%s" # current time+%s
}

# get a unique output directory name based on the current timestamp
function get_unique_output_dir() {
  echo "drc_out_$(timestamp)"
}

function create_output_dir() {
  # create the target parent directory if it does not exist
  if [ ! -d "$1" ]; then
    mkdir -p "$1"
  fi
}

function require_command {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Error: required command not found: $1" >&2
    exit 1
  fi
}

# calculate using bc
function calculate_bc {
  echo "$1" | bc
}


function calculate_start_freq {
  calculate_bc "$1 * 2"
}


function calculate_end_freq {
  calculate_bc "$1 / 2"
}


# calculate window taps from milliseconds
function calculate_window_taps {
  calculate_bc "$1 * $OPERATING_FREQUENCY / 500"
}


function calculate_ep_lower_window_taps {
  calculate_bc "$1 / $A_FACTOR_EP_LOWER_WINDOW"
}


function calculate_is_pe_lower_window_taps {
  calculate_bc "$1 / 2"
}


function calculate_is_pe_upper_window_taps {
  calculate_bc "$1 * 75 / 100"
}

require_command sox
require_command drc
require_command bc


if [ $# -eq 0 ]; then
  print_help
  exit 1
fi

while [ $# -gt 0 ]; do
  case "$1" in
    -b|--bit-depth)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      IMPULSE_RESPONSE_BIT_DEPTH="$2"
      shift 2
      ;;
    --bit-depth=*)
      IMPULSE_RESPONSE_BIT_DEPTH="${1#*=}"
      shift
      ;;
    -f|--frequency)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      set_operating_frequency "$2"
      shift 2
      ;;
    --frequency=*)
      set_operating_frequency "${1#*=}"
      shift
      ;;
    -c|--config)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      DRC_CONFIGURATION_FILE_PREFIX="$2"
      shift 2
      ;;
    --config=*)
      DRC_CONFIGURATION_FILE_PREFIX="${1#*=}"
      shift
      ;;
    -m|--mic-compensation)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      MIC_COMP_FILE="$2"
      shift 2
      ;;
    --mic-compensation=*)
      MIC_COMP_FILE="${1#*=}"
      shift
      ;;
    -t|--target-curve)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      TARGET_CURVE="$2"
      shift 2
      ;;
    --target-curve=*)
      TARGET_CURVE="${1#*=}"
      shift
      ;;
    -s|--start-frequency)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      # Start frequency where the reference RMS level used for peak limiting is computed. Default value set to 100 Hz.
      # This value should be set typically to something like an octave above the minimum reproducible frequency of your speakers.
      START_FREQ=$(calculate_start_freq "$2")
      shift 2
      ;;
    --start-frequency=*)
      START_FREQ=$(calculate_start_freq "${1#*=}")
      shift
      ;;
    -e|--end-frequency)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      # End frequency where the reference RMS level used for peak limiting is computed. Default value set to 10000 Hz.
      # This value should be set typically to something like an octave below the maximum reproducible frequency of your speakers.
      END_FREQ=$(calculate_end_freq "$2")
      shift 2
      ;;
    --end-frequency=*)
      END_FREQ=$(calculate_end_freq "${1#*=}")
      shift
      ;;
    -g|--max-gain)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      PEAK_LIMITING_MAX_GAIN="$2"
      shift 2
      ;;
    --max-gain=*)
      PEAK_LIMITING_MAX_GAIN="${1#*=}"
      shift
      ;;
    -p|--window-exponent)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      WINDOW_EXPONENT="$2"
      shift 2
      ;;
    --window-exponent=*)
      WINDOW_EXPONENT="${1#*=}"
      shift
      ;;
    -l|--lower-window)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      LOWER_WINDOW_TAPS=$(calculate_window_taps "$2")
      EP_LOWER_WINDOW_TAPS=$(calculate_ep_lower_window_taps "$LOWER_WINDOW_TAPS")
      IS_PE_LOWER_WINDOW_TAPS=$(calculate_is_pe_lower_window_taps "$EP_LOWER_WINDOW_TAPS")
      IS_PE_UPPER_WINDOW_TAPS=$(calculate_is_pe_upper_window_taps "$IS_PE_LOWER_WINDOW_TAPS")
      shift 2
      ;;
    --lower-window=*)
      LOWER_WINDOW_TAPS=$(calculate_window_taps "${1#*=}")
      EP_LOWER_WINDOW_TAPS=$(calculate_ep_lower_window_taps "$LOWER_WINDOW_TAPS")
      IS_PE_LOWER_WINDOW_TAPS=$(calculate_is_pe_lower_window_taps "$EP_LOWER_WINDOW_TAPS")
      IS_PE_UPPER_WINDOW_TAPS=$(calculate_is_pe_upper_window_taps "$IS_PE_LOWER_WINDOW_TAPS")
      shift
      ;;
    -u|--upper-window)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      UPPER_WINDOW_TAPS=$(calculate_window_taps "$2")
      shift 2
      ;;
    --upper-window=*)
      UPPER_WINDOW_TAPS=$(calculate_window_taps "${1#*=}")
      shift
      ;;
    -o|--output-dir)
      [ -n "$2" ] || { echo "Error: option $1 requires an argument"; echo; print_help; exit 1; }
      TARGET_PARENT="$2"
      create_output_dir "$TARGET_PARENT"
      shift 2
      ;;
    --output-dir=*)
      TARGET_PARENT="${1#*=}"
      create_output_dir "$TARGET_PARENT"
      shift
      ;;
    -h|--help)
      print_help
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Invalid option: $1"
      echo
      print_help
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -lt 1 ]; then
  echo "Error: at least one IMPULSE file is required"
  echo
  print_help
  exit 1
fi

# check if the required parameters are set before proceeding

# check if the required window taps are set
if [ -z "$LOWER_WINDOW_TAPS" ] || [ -z "$UPPER_WINDOW_TAPS" ]; then
  echo "Error: the required window taps are not set." >&2
  exit 1
fi

# some parameters are set so it is possible to create working directory
if [ -n "$TARGET_PARENT" ]; then
  OUT_DIR="${TARGET_PARENT%/}/$(get_unique_output_dir)"
else
  OUT_DIR="$(get_unique_output_dir)"
fi

mkdir -p "$OUT_DIR"

# create output directory for 16-bit WAV files
WAV_16_BIT_OUT_DIR=$OUT_DIR/wav
mkdir -p "$WAV_16_BIT_OUT_DIR"

# handle cases where a microphone correction is not available or a target curve is not set
if [ -z "$MIC_COMP_FILE" ]; then
  MIC_COMP_FILE="$OUT_DIR/$DEFAULT_NAME_MIC_COMPENSATION_FILE"
  print_flat_file "$MIC_COMP_FILE" "$OPERATING_FREQUENCY"
fi

if [ -z "$TARGET_CURVE" ]; then
  TARGET_CURVE="$OUT_DIR/$DEFAULT_NAME_TARGET_CURVE_FILE"
  print_flat_file "$TARGET_CURVE" "$OPERATING_FREQUENCY"
fi

function process_impulse {
  local INPUT_FILE="$1"
  local BASENAME
  local IMPULSE_RESPONSE_RAW_FILE
  local MIC_COMPENSATED_IMPULSE_RESPONSE_FILE
  local DRC_OUTPUT_FILE
  local DRC_OUTPUT_MINIMUM_PHASE_FILE
  local DRC_OUTPUT_TEST_CONVOLUTION_FILE
  local DRC_CONFIGURATION_FILE
  local OUTPUT_NAME
  local WAV_FILENAME
  local -a DRC_ARGS
  local -a DRC_OUTPUT_FILENAMES_ARRAY

  if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: input file not found: $INPUT_FILE" >&2
    return 1
  fi

  BASENAME=$(basename "$INPUT_FILE" | sed 's/\.[^.]*$//')

  IMPULSE_RESPONSE_RAW_FILE="${BASENAME}_${IMPULSE_RESPONSE_RAW_FILE_SUFFIX}.${RAW_EXT}"
  MIC_COMPENSATED_IMPULSE_RESPONSE_FILE="${BASENAME}_${MIC_COMPENSATED_IMPULSE_RESPONSE_SUFFIX}.${RAW_EXT}"
  DRC_OUTPUT_FILE="${BASENAME}.${RAW_EXT}"
  DRC_OUTPUT_MINIMUM_PHASE_FILE="${BASENAME}_${MINIMUM_PHASE_SUFFIX}.${RAW_EXT}"
  DRC_OUTPUT_TEST_CONVOLUTION_FILE="${BASENAME}_${TEST_CONVOLUTION_SUFFIX}.${RAW_EXT}"
  DRC_CONFIGURATION_FILE="${CONFIG_DIR}/${DRC_CONFIGURATION_FREQUENCY_FOLDER}/${DRC_CONFIGURATION_FILE_PREFIX}-${DRC_CONFIGURATION_FILE_FREQUENCY}.${DRC_EXT}"

  # converting impulse response from signed integer wave (default REW output format) to raw pcm floating point 32 bit (DRC capable)
  sox -t wav -e signed-integer -b "$IMPULSE_RESPONSE_BIT_DEPTH" -r "$OPERATING_FREQUENCY" -c 1 "$INPUT_FILE" -t raw -e floating-point -b 32 -r "$OPERATING_FREQUENCY" -c 1 "$OUT_DIR/$IMPULSE_RESPONSE_RAW_FILE" || return 1

  DRC_ARGS=(
    "--BCInFile=$OUT_DIR/$IMPULSE_RESPONSE_RAW_FILE"
    "--MCFilterType=M"
    "--MCPointsFile=$MIC_COMP_FILE"
    "--MCOutFile=$OUT_DIR/$MIC_COMPENSATED_IMPULSE_RESPONSE_FILE"
    "--MPWindowExponent=$WINDOW_EXPONENT"
    "--EPWindowExponent=$WINDOW_EXPONENT"
    "--RTWindowExponent=$WINDOW_EXPONENT"
    "--MPLowerWindow=$LOWER_WINDOW_TAPS"
    "--MPUpperWindow=$UPPER_WINDOW_TAPS"
    "--EPLowerWindow=$EP_LOWER_WINDOW_TAPS"
    "--EPUpperWindow=$UPPER_WINDOW_TAPS"
    "--RTLowerWindow=$LOWER_WINDOW_TAPS"
    "--RTUpperWindow=$UPPER_WINDOW_TAPS"
    "--ISPETType=f"
    "--ISPELowerWindow=$IS_PE_LOWER_WINDOW_TAPS"
    "--ISPEUpperWindow=$IS_PE_UPPER_WINDOW_TAPS"
    "--PLStartFreq=$START_FREQ"
    "--PLEndFreq=$END_FREQ"
    "--PLMaxGain=$PEAK_LIMITING_MAX_GAIN"
    "--PSPointsFile=$TARGET_CURVE"
    "--PSOutFile=$OUT_DIR/$DRC_OUTPUT_FILE"
    "--MSOutFile=$OUT_DIR/$DRC_OUTPUT_MINIMUM_PHASE_FILE"
    "--TCOutFile=$OUT_DIR/$DRC_OUTPUT_TEST_CONVOLUTION_FILE"
    "$DRC_CONFIGURATION_FILE"
  )

  echo "executing drc for: $INPUT_FILE"
  echo
  echo "drc \"${DRC_ARGS[*]}\""
  echo
  drc "${DRC_ARGS[@]}" || {
    rm -f "$OUT_DIR/$IMPULSE_RESPONSE_RAW_FILE"
    return 1
  }

  DRC_OUTPUT_FILENAMES_ARRAY=(
    "$MIC_COMPENSATED_IMPULSE_RESPONSE_FILE"
    "$DRC_OUTPUT_FILE"
    "$DRC_OUTPUT_MINIMUM_PHASE_FILE"
    "$DRC_OUTPUT_TEST_CONVOLUTION_FILE"
  )

  for OUTPUT_NAME in "${DRC_OUTPUT_FILENAMES_ARRAY[@]}"
  do
    WAV_FILENAME="${OUTPUT_NAME%.${RAW_EXT}}.${WAVE_EXT}"

    # convert all drc output files into 16 bit wav
    # REW better manages this kind of format
    sox -t raw -e floating-point -b 32 -r "$OPERATING_FREQUENCY" -c 1 "$OUT_DIR/$OUTPUT_NAME" -t wav -e signed-integer -b 16 -r "$OPERATING_FREQUENCY" -c 1 "$WAV_16_BIT_OUT_DIR/$WAV_FILENAME" || {
      rm -f "$OUT_DIR/$IMPULSE_RESPONSE_RAW_FILE"
      return 1
    }
  done

  echo
  echo "cleaning..."
  rm -f "$OUT_DIR/$IMPULSE_RESPONSE_RAW_FILE"

  return 0
}

SUCCESS_COUNT=0
FAIL_COUNT=0

for INPUT_FILE in "$@"
do
  if process_impulse "$INPUT_FILE"; then
    SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
  else
    FAIL_COUNT=$((FAIL_COUNT + 1))
    echo "Failed processing: $INPUT_FILE" >&2
  fi
done

echo
echo "Summary: $SUCCESS_COUNT succeeded, $FAIL_COUNT failed"
echo "Output directory: $OUT_DIR"

if [ "$FAIL_COUNT" -gt 0 ]; then
  exit 1
fi
